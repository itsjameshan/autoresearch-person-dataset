{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TriageDiagnosis",
  "type": "object",
  "required": ["root_cause_hypothesis", "confidence", "recommended_action"],
  "properties": {
    "root_cause_hypothesis": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "recommended_action": {
      "type": "string",
      "enum": ["rollback", "retry_with_fix", "escalate_human"]
    },
    "fix_diff": {
      "type": "object",
      "description": "retry_with_fix时的修复配置"
    }
  }
}
