{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BugFixerDiagnosis",
  "type": "object",
  "required": ["root_cause_hypothesis", "confidence", "recommended_action"],
  "properties": {
    "root_cause_hypothesis": {
      "type": "string",
      "description": "根因假设"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "置信度 (0.0-1.0)"
    },
    "recommended_action": {
      "type": "string",
      "enum": [
        "break_loop",
        "fix_db",
        "kill_zombie",
        "clean_corrupted",
        "fix_yaml",
        "fix_source",
        "force_restart_all",
        "deep_fix",
        "escalate"
      ],
      "description": "推荐修复动作"
    },
    "fix_detail": {
      "type": "object",
      "description": "修复详情，可包含需要修改的参数键值对"
    },
    "needs_agent_restart": {
      "type": "boolean",
      "default": false,
      "description": "是否需要重启智能体"
    },
    "target_agent": {
      "type": "string",
      "description": "目标智能体名称 (Orchestrator, SupervisorAgent, ArchitectureSupervisor, all 等)"
    }
  }
}